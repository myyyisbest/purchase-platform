# ============================================================
# 采购分析平台 - 环境变量模板
# 使用方式：cp .env.example .env 后按实际填写
# 切勿将真实 .env 提交到代码仓库
# ============================================================

# ---------- 业务数据库（PostgreSQL / MySQL 二选一） ----------
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=purchase_db
DB_USER=postgres
DB_PASSWORD=

# ---------- SAP HANA 源库连接（仅同步功能依赖） ----------
HANA_HOST=
HANA_PORT=30041
HANA_USER=
HANA_PASSWORD=
# HANA 视图全限定名（含 schema，双引号保留）
HANA_VIEW_NAME=

# ---------- 应用安全 ----------
# JWT 签名密钥：生产必须改为强随机字符串，长度 >= 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
# CORS 允许的前端来源，多个用逗号分隔
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- 大模型 API（AI 助手，可选） ----------
MAAS_BASE_URL=https://api.example.com/v1
MAAS_API_KEY=
MAAS_MODEL=

# ---------- 初始账户密码（仅首次建仓使用，建议登录后立即修改） ----------
DEFAULT_ADMIN_PASSWORD=
DEFAULT_USER_PASSWORD=

# ---------- 定时任务 Cron Token（HANA 同步脚本等） ----------
# 非空时允许通过请求头 X-Cron-Token 或 Authorization: Bearer 访问需管理员的同步接口
# 未配置时 cron 头鉴权失败关闭（JWT admin 仍可用）
CRON_API_TOKEN=
